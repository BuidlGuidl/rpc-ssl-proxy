[Unit]
Description=Daily Let's Encrypt renewal check for rpc-ssl-proxy

[Timer]
# A no-op check costs ~50ms and makes no ACME request, since certbot only acts
# once the cert is inside its last 30 days. Checking daily therefore gives ~30
# chances to get through a transient failure, against the one attempt per month
# the old cron job allowed. Upstream certbot suggests twice daily; this is the
# deliberately quieter end of that.
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=45m
# Run on boot if a scheduled check was missed while the instance was down.
Persistent=true

[Install]
WantedBy=timers.target
